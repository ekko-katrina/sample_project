CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"
CONFIG_TMY05_FW_VERSION_MAJOR=1
CONFIG_TMY05_FW_VERSION_MINOR=0
CONFIG_TMY05_FW_VERSION_PATCH=4
